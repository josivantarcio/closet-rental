# =============================================================================
# .env.example — Variáveis de ambiente para o Closet Rental
# =============================================================================
# Instruções:
#   cp .env.example .env
#   Edite o .env com os valores reais
#   NUNCA commite o .env no git (já está no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Spring Profile
# -----------------------------------------------------------------------------

# Valores possíveis: (vazio = dev local) | prod
# Em produção, definir: SPRING_PROFILES_ACTIVE=prod
# Isso ativa application-prod.yml (desativa show-sql e Swagger)
SPRING_PROFILES_ACTIVE=

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------

APP_PORT=8080

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=aluguel
DB_USER=postgres
DB_PASSWORD=postgres

# Variáveis usadas pelo docker-compose para criar o container do banco
POSTGRES_DB=aluguel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# Chave secreta HS256 (mínimo 256 bits — 64 hex chars)
# Obrigatória: a aplicação não sobe sem ela. Gere com: openssl rand -hex 32
JWT_SECRET=

# Expiração do token em segundos (86400 = 24h)
JWT_EXPIRATION=86400

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Origens permitidas (separar por vírgula para múltiplas)
# Nota: Docker Desktop ocupa a porta 3000 — usar 3001 quando Docker Desktop estiver ativo
CORS_ALLOWED_ORIGINS=http://localhost:3001

# -----------------------------------------------------------------------------
# JPA / Hibernate
# -----------------------------------------------------------------------------

# true em dev, false em produção
SHOW_SQL=true

# -----------------------------------------------------------------------------
# E-mail / SMTP
# -----------------------------------------------------------------------------

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seuemail@seudominio.com.br
MAIL_PASSWORD=sua-senha-de-app

# -----------------------------------------------------------------------------
# Storage — imagens de produtos
# -----------------------------------------------------------------------------

# "local" em dev | "s3" em produção
STORAGE_PROVIDER=local

# Diretório local para uploads (dev apenas)
STORAGE_LOCAL_DIR=uploads

# AWS S3 (obrigatório quando STORAGE_PROVIDER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=closet-rental-uploads-prod

# URL pública para servir imagens (CloudFront em produção)
# Exemplo: https://d1example.cloudfront.net
CLOUDFRONT_URL=

# -----------------------------------------------------------------------------
# Regras de negócio
# -----------------------------------------------------------------------------

CAUCAO_PADRAO=100.00
PERCENTUAL_MULTA_DIARIA=0.10
TAXA_FALHA_GATEWAY=0.10

# -----------------------------------------------------------------------------
# Produção — AWS ECS (não usar em dev local)
# -----------------------------------------------------------------------------

# Injetadas pelo ECS via Secrets Manager — documente aqui para referência:
#   SPRING_DATASOURCE_URL     → jdbc:postgresql://<rds-endpoint>:5432/aluguel
#   SPRING_DATASOURCE_USERNAME → aluguel_user
#   SPRING_DATASOURCE_PASSWORD → (gerado pelo Terraform)
#   APP_JWT_SECRET            → (openssl rand -hex 32)
#   APP_JWT_REFRESH_EXPIRATION → 604800
#   MAIL_HOST                 → email-smtp.us-east-1.amazonaws.com
#   MAIL_USERNAME             → (SMTP access key — output do Terraform)
#   MAIL_PASSWORD             → (SMTP secret — output do Terraform)
#   CORS_ALLOWED_ORIGINS      → https://seu-atelier.netlify.app
#   AWS_REGION                → us-east-1
#   S3_BUCKET                 → closet-rental-uploads-prod
#   CLOUDFRONT_URL            → https://d1example.cloudfront.net
